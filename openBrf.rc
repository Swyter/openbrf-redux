#define _STRINGIFY(s) #s
#define STRINGIFY(s) _STRINGIFY(s)

IDI_ICON1               ICON    DISCARDABLE     "openBrf.ico"
1 VERSIONINFO
 FILEVERSION    QMAKE_BUILD_YEA, QMAKE_BUILD_MON, QMAKE_BUILD_DAY, 1337
 PRODUCTVERSION QMAKE_BUILD_YEA, QMAKE_BUILD_MON, QMAKE_BUILD_DAY, 1337
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
 BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE         "Comments","Opens Mount&Blade Binary Resource files"
            VALUE      "CompanyName", "Marco Tarini, Swyter"
            VALUE  "FileDescription", "OpenBRF Redux"
            VALUE      "FileVersion", STRINGIFY(QMAKE_BUILD_YEA) "." STRINGIFY(QMAKE_BUILD_MON) "." STRINGIFY(QMAKE_BUILD_DAY)
            VALUE   "ProductVersion", STRINGIFY(QMAKE_BUILD_YEA) "." STRINGIFY(QMAKE_BUILD_MON) "." STRINGIFY(QMAKE_BUILD_DAY)
            VALUE     "InternalName", "OpenBRF Redux"
            VALUE   "LegalCopyright", "Given under the GNU General Public License"
            VALUE "OriginalFilename", "OpenBrf.exe"
            VALUE      "ProductName", "OpenBRF Redux"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
 END

1 24 "openBrf.win32manifest.xml" /* swy: 24 = RT_MANIFEST */